{
  "analyzers_all": ["cppcheck", "frama-c", "splint", "infer", "flawfinder", "rats", "clang-static-analyzer", "pvs-studio", "sparse", "ikos", "esbmc"],
  "tests": [
    {
      "name": "Buffer Overflow (CWE 120)",
      "path": "tests/sa-tests-db/basic_set/c/3-buffer-overflow",
      "cwe": 120,
      "analyzers": {

        "cppcheck": {
          "accepted_errors": [
            "arrayIndexOutOfBounds",
            "bufferAccessOutOfBounds",
            "arrayIndexOutOfBoundsCond",
            "outOfBounds"
          ]
        },

        "frama-c": {
          "accepted_errors": [
            "out of bounds",
            "invalid memory access"
          ]
        },

        "splint": {
          "accepted_errors": [
            "Possible out-of-bounds store"
          ]
        },

        "infer": {
          "accepted_errors": [
            "BUFFER_OVERRUN_L1",
            "BUFFER_OVERRUN_L2",
            "Out of bounds write",
            "PULSE_UNINITIALIZED_VALUE"
          ]
        },

        "flawfinder": {
          "accepted_errors": [
            "buffer overflow",
            "potential overflows",
            "CWE-120",
            "CWE-119"
          ]
        },

        "rats": {
          "accepted_errors": [
            "buffer overflow",
            "memset",
            "High risk: memset"
          ]
        },

        "clang-static-analyzer" : {
          "accepted_errors": [
            "buffer overflow",
            "alpha.unix.cstring.OutOfBounds",
            "alpha.security.ArrayBound",
            "alpha.security.ArrayBoundV2"
          ]
        },

        "pvs-studio": {
          "accepted_errors": [
            "V512", "V557"
          ]
        },

        "sparse": {
          "accepted_errors": [
            "invalid access",
            "out of bounds",
            "buffer overflow",
            "array access"
          ]
        },

        "ikos": {
          "accepted_errors": [
            "buffer overflow",
            "out of bounds",
            "accesses",
            "could not bound"
          ]
        },

        "esbmc": {
          "accepted_errors": [
            "array bounds violated",
            "unwinding assertion",
            "writing memory segment"
          ]
        }
      }
    },

    {
      "name": "Invalid Free or Memory Management (CWE 763)",
      "path": "tests/sa-tests-db/basic_set/c/lang3-mem-mgmt",
      "cwe": 763,
      "analyzers": {
        
        "cppcheck": {
          "accepted_errors": [
            "memleak",
            "doubleFree",
            "deallocuse"
          ],
          "accepted_cwe": [763, 761, 415, 416]
        },
        
        "frama-c": {
          "accepted_errors": [
            "invalid memory access",
            "escaping address",
            "out of bounds write",
            "out of bounds read"
          ],
          "accepted_cwe": [763, 761, 415, 416]
        },
        
        "splint": {
          "accepted_errors": [
            "memory leak",
            "not released",
            "Memory is used after it has been released"
          ],
          "accepted_cwe": [763]
        },
        
        "infer": {
          "accepted_errors": [
            "INVALID_FREE",
            "MEMORY_LEAK_C",
            "USE_AFTER_FREE",
            "NULLPTR_DEREFERENCE"
          ],
          "accepted_cwe": [763, 415, 416]
        },

        "flawfinder": {
          "accepted_errors": [
            "Does not check for buffer overflows"
          ],
          "accepted_cwe": [763]
        },

        "rats": {
          "accepted_errors": [
            "free called on invalid pointer",
            "high risk: free",
            "CWE-763"
          ],
          "accepted_cwe": [763]
        },

        "clang-static-analyzer": {
          "accepted_errors": [
            "unix.Malloc",
            "Use of memory after it is freed",
            "Attempt to free released memory"
          ],
          "accepted_cwe": [763]
        }
      }
    },
